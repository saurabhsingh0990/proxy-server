{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build and Run Proxy (MinGW + PowerShell)",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-Command",
          "g++ src/main.cpp src/server.cpp -Iinclude -std=c++11 -o proxy -lws2_32; ./proxy"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "options": {
          "cwd": "${workspaceFolder}"
        }
      }
    ]
  }
  